# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Backend URL (server-side only — do not prefix with NEXT_PUBLIC_)
BACKEND_URL=http://localhost:8080

# Public URLs (available in browser)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Cloudflare Turnstile site key (anti-bot on guest-room entry). Leave unset to
# hide the widget (local dev). Pair with TURNSTILE_SECRET on the backend.
# Baked at build time — restart `npm run dev` (or rebuild) after changing it.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
