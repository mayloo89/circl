# Generic production environment for Circl.
#
#   cp docs/deploy/.env.prod.example deploy/.env.prod
#   chmod 600 deploy/.env.prod                # secrets — readable only by you
#   nano    deploy/.env.prod                  # replace every CHANGE_ME
#
# Random-secret generators:
#   openssl rand -base64 32                   # POSTGRES_PASSWORD, JWT_SECRET, AUTH_SECRET (three different values)
#   npx web-push generate-vapid-keys          # VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY

# ─────────────────────────────────────────────────────────────────────────────
# Domain — the public hostname your reverse proxy serves the app on.
# Everything that gets baked into the frontend bundle (NEXT_PUBLIC_*) is
# derived from this, so a domain change requires `up -d --build frontend`.
# ─────────────────────────────────────────────────────────────────────────────
DOMAIN=example.com

# ─────────────────────────────────────────────────────────────────────────────
# Postgres
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=circl_user
POSTGRES_DB=circl_db
POSTGRES_PASSWORD=CHANGE_ME

# Backend connects via the docker service name `postgres`.
DATABASE_URL=postgres://circl_user:CHANGE_ME@postgres:5432/circl_db?sslmode=disable

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────────
# Backend runtime
# ─────────────────────────────────────────────────────────────────────────────
ENV=production
PORT=8080
LOG_LEVEL=info
FRONTEND_URL=https://${DOMAIN}
CORS_ALLOWED_ORIGINS=https://${DOMAIN}

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — JWT_SECRET signs backend JWTs; AUTH_SECRET signs the NextAuth
# session cookie on the frontend. They are independent — generate two
# different values.
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
AUTH_SECRET=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Storage — files live in the `uploads_data` docker volume and the backend
# serves them at /uploads/files/. Adjust the URL if your reverse proxy
# routes them somewhere else (e.g. mounting a CDN in front).
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_STORAGE_BASE_URL=https://${DOMAIN}/api/uploads/files

# ─────────────────────────────────────────────────────────────────────────────
# Image moderation — NudeNet sidecar built from ops/moderation/.
# Leave MODERATION_API_URL unset to disable the classifier (NoopClassifier);
# uploads still pass through the hash-list + heuristic detectors. The
# retention env controls how long rejected NSFW / heuristic upload files
# are kept for admin review — hash-list (CSAM / NCII) matches always purge
# immediately, regardless of this value.
# ─────────────────────────────────────────────────────────────────────────────
MODERATION_API_URL=http://moderation:8000
NSFW_THRESHOLD=0.70
MODERATION_REJECTED_RETENTION_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# Web Push (VAPID) — required for browser push notifications.
# Leave keys blank to disable push (the app still works without them).
# ─────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@${DOMAIN}

# ─────────────────────────────────────────────────────────────────────────────
# SMTP — Brevo / Mailgun / SendGrid / Amazon SES / Gmail.
# Brevo (free tier 300/day) example shown.
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=Circl <no-reply@${DOMAIN}>

# ─────────────────────────────────────────────────────────────────────────────
# Anti-bot (Cloudflare Turnstile) — verifies guest entry to public rooms.
# Leave both blank to disable. Create a widget at dash.cloudflare.com → Turnstile,
# adding your domain (and `localhost` for dev) as a hostname. The site key is
# baked into the frontend bundle (so a change needs `up -d --build frontend`);
# the secret stays server-side.
# ─────────────────────────────────────────────────────────────────────────────
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Optional tuning
# ─────────────────────────────────────────────────────────────────────────────
# IMAGE_MAX_PX=1024
# LOGIN_IP_LIMIT=20
# REGISTER_IP_LIMIT=10
# NEXT_PUBLIC_SITE_URL=https://${DOMAIN}
