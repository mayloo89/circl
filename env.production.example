# Copy this file to .env.prod and fill in your values.
# Run with: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# --- Database ---
POSTGRES_USER=circl_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=circl_db

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-min-32-chars-random-string

# --- Storage (MinIO) ---
S3_BUCKET=circl-media
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password
# Public URL where uploaded files are served (seen by the browser).
# For local testing: http://localhost:9000/circl-media
# For production:    https://cdn.example.com
S3_PUBLIC_URL=http://localhost:9000/circl-media

# --- Frontend ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Public URLs (must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Hostname of the image server (for next/image — extracted from S3_PUBLIC_URL)
# For local MinIO:    localhost / 9000 / http
# For production CDN: cdn.example.com / (empty) / https
NEXT_PUBLIC_IMAGE_HOSTNAME=localhost
NEXT_PUBLIC_IMAGE_PORT=9000
NEXT_PUBLIC_IMAGE_PROTOCOL=http

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
