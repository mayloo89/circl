# Server
PORT=8080
ENV=development

# Database
# Formato: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://circl_user:circl_password@localhost:5432/circl_db?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET=your-jwt-secret-here-min-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# S3 / Media
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=circl-media
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Worker
ASYNQ_REDIS_URL=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seguridad
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
