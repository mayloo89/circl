# Server
PORT=8080
ENV=development

# Database
# Formato: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=disable
DATABASE_URL=postgres://circl_user:circl_password@localhost:5432/circl_db?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT / Auth
JWT_SECRET=your-jwt-secret-here-min-32-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Storage
# Use "local" for development (files saved to ./data/uploads)
# Use "s3" for any S3-compatible provider (MinIO, AWS S3, Cloudflare R2, etc.)
STORAGE_PROVIDER=local

# S3-compatible storage (required when STORAGE_PROVIDER=s3)
# For local MinIO: S3_ENDPOINT=http://localhost:9000
# For AWS S3:      S3_ENDPOINT=https://s3.amazonaws.com
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=circl-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public URL used to build file URLs served to the browser.
# For local MinIO: http://localhost:9000/circl-media
# For a CDN:       https://cdn.example.com
S3_PUBLIC_URL=http://localhost:9000/circl-media

# Worker
ASYNQ_REDIS_URL=redis://localhost:6379/1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seguridad
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Email
# Use "console" to log emails to stdout (default, no setup needed).
# Use "smtp" to send via SMTP (point at Mailpit locally or a real provider in prod).
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@circl.app
FRONTEND_URL=http://localhost:3000

# Set to true only for local E2E testing — never in production
TEST_ENDPOINTS_ENABLED=false

# OpenTelemetry tracing
# Point at the Tempo container when running docker-compose.
# Leave empty to disable tracing (no-op tracer).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=circl-backend
# Sampling rate: 1.0 = 100% (dev), lower in prod (e.g. 0.1)
OTEL_SAMPLE_RATE=1.0

# Loki log shipping — direct HTTP push from the backend process.
# Leave empty to disable (logs only go to stdout).
LOKI_URL=http://localhost:3100
