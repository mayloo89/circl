# Production environment — copy to .env.prod and fill in all CHANGE_ME values.
# Keep .env.prod out of git (it's in .gitignore).
#
# Generate secrets with: openssl rand -base64 32
# Generate VAPID keys with: npx web-push generate-vapid-keys

# ── Domain ──────────────────────────────────────────────────────────────────
# Used by docker-compose.prod.yml to build NEXT_PUBLIC_* vars and AUTH_URL.
DOMAIN=circl.unlug.ar

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=circl_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=circl_db
DATABASE_URL=postgres://circl_user:CHANGE_ME@postgres:5432/circl_db?sslmode=disable

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT (backend token signing) ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME

# ── NextAuth / Auth.js v5 (frontend session) ────────────────────────────────
# AUTH_SECRET signs the session cookie — must be strong and secret.
AUTH_SECRET=CHANGE_ME

# ── Backend config ──────────────────────────────────────────────────────────
ENV=production
PORT=8080
LOG_LEVEL=info
FRONTEND_URL=https://circl.unlug.ar
CORS_ALLOWED_ORIGINS=https://circl.unlug.ar

# ── Storage (local filesystem — no S3/minio needed on Pi) ───────────────────
STORAGE_PROVIDER=local
# Public URL where uploaded files are served (via nginx → backend → /app/data).
LOCAL_STORAGE_BASE_URL=https://circl.unlug.ar/api/uploads/files

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Required for email verification and password reset flows.
# Free options: Brevo (300/day), Resend (100/day), Gmail SMTP.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@circl.ar

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
# Leave blank to disable push notifications (app still works without them).
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@circl.ar
